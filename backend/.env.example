# ============================================================
# LARISKA AI — Backend Environment Variables
# Copy file ini menjadi `.env` dan isi dengan value asli.
# JANGAN commit file `.env` (pastikan sudah ada di .gitignore)
# ============================================================

# --- Supabase (Sprint 2A: wajib diisi sekarang) ---

# Project URL Supabase, dari Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — aman untuk operasi yang tunduk RLS
SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — SECRET. Bypass semua RLS. Backend-only,
# dipakai untuk operasi admin (mis. webhook WhatsApp menulis data
# atas nama sistem, bukan atas nama user yang login).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct connection string ke PostgreSQL (dipakai kalau backend
# konek langsung via SQLAlchemy/psycopg, bukan lewat Supabase client)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- WhatsApp Cloud API (akan diisi di sprint integrasi WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token bebas yang kalian tentukan sendiri, dipakai Meta untuk
# verifikasi saat pertama kali setup webhook
WHATSAPP_VERIFY_TOKEN=

# --- LLM Provider (akan diisi di sprint AI Pipeline) ---
# Pilih salah satu provider: gemini | groq | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- Payment Gateway (akan diisi di sprint transaksi) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- App Config ---
ENVIRONMENT=development

APP_SECRET_KEY=your-secret-key

BACKEND_CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
