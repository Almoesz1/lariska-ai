# ============================================================
# LARISKA AI — Backend Environment Variables (SAFE TEMPLATE)
# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env or production credentials.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# --- WhatsApp Cloud API (optional for Local Demo; required for live WhatsApp) ---
WHATSAPP_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-private-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# --- LLM Provider (required for NLU) ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key
# Compatibility aliases used by legacy modules; use the same Gemini key.
GOOGLE_API_KEY=your-gemini-api-key
LLM_API_KEY=your-gemini-api-key

# --- Payment Gateway (optional for Local Demo; required for invoice/payment) ---
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# --- App Config ---
ENVIRONMENT=development
APP_SECRET_KEY=replace-with-a-long-random-secret
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
